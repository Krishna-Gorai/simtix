fpga/vivado_project_fp/
# managed MNIST GUI project (regenerate with fpga/create_project_mnist.tcl)
fpga/vivado_project_mnist/
# managed MNIST post-synth sim project (regenerate with fpga/create_project_mnist_sim.tcl)
fpga/vivado_project_mnist_sim/
