# riscv toolchain build artifacts
*.elf
*.bin
kernels/**/*.o
kernels/**/*.dump
# generated by kernels/build_kernels.sh (sources of record are the .S files)
*.hex
*.svh

# LaTeX build artifacts (paper PDF is committed; intermediates are not)
*.aux
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
docs/paper/*.log

# editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# MNIST demo (AI-4): raw dataset downloads (regenerated by ml/mnist_quant.py).
# The exported ml/data/mnist_int8.npz golden IS tracked (small, deterministic).
ml/data/*.gz
ml/data/*-ubyte

# MNIST demo (AI-4): tb-loadable hex is regenerated by ml/mnist_quant.py.
ml/data/*.hex
